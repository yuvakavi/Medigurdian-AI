# =========================================================
# Medigurdian AI — backend configuration
#
# Copy this file to `backend/.env` and fill in the real values.
# `.env` must never be committed.
# =========================================================

APP_NAME=Medigurdian AI
ENVIRONMENT=development

# Legacy SQLAlchemy models (local SQLite). The live API uses Supabase.
DATABASE_URL=sqlite:///./medigurdian.db

# -------------------------------------------------------------
# Supabase
# SUPABASE_PUBLISHABLE_KEY is the browser-safe publishable key.
# NEVER place a service-role key in this file's frontend counterpart
# (frontend/.env) — Vite inlines VITE_* values into the client bundle.
# -------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only admin key. Used by the optional mock-patient seeding script and
# for private medical-report storage operations. NEVER put this in
# frontend/.env, a VITE_* variable or any public file. Reports can still be
# listed and their details viewed without it, but upload, download and delete
# return 503.
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# Frontend origin allowed by CORS.
# Must match the origin the browser uses, e.g. http://localhost:5173
# -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# -------------------------------------------------------------
# Storage
# -------------------------------------------------------------
# Legacy local SQLite uploads (kept for existing models).
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db

# Private Supabase Storage bucket for patient medical reports.
# Create it with backend/migrations/20261023_medical_reports_storage.sql.
REPORT_STORAGE_BUCKET=medical-reports
REPORT_MAX_FILE_SIZE_BYTES=10485760

# Report analysis. OCR is bundled in the Python dependencies
# (rapidocr-onnxruntime + pypdfium2), so no external Tesseract binary is needed.
# Set this to false to use only deterministic extraction rules.
REPORT_ANALYSIS_LLM_ENABLED=true

# -------------------------------------------------------------
# AI provider
# -------------------------------------------------------------
llm_provider=mock
llm_model=llama3
